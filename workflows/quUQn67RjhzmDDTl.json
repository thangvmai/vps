      "parameters": {
        "jsCode": "// Duyệt qua từng sản phẩm trong danh sách items và xử lý lại thông tin\nreturn items.map(item => {\n  \n  // Lấy giá trị tồn kho gốc từ dữ liệu (có thể là số, null, undefined, chuỗi...)\n  const rawQty = item.json.stock_quantity;\n  \n  // Kiểm tra tồn kho có phải là số hợp lệ hay không\n  // Nếu đúng là số => giữ nguyên\n  // Nếu không phải số (null, undefined, chuỗi, NaN...) => gán là 0 để tránh lỗi\n  const safeQty = (typeof rawQty === 'number' && !isNaN(rawQty))\n    ? rawQty\n    : 0;\n  \n  // Trả về đối tượng mới đã xử lý sạch dữ liệu\n  return {\n    json: {\n      name: item.json.name,       // Lấy tên sản phẩm\n      sku: item.json.sku || '',   // Lấy mã SKU, nếu không có thì gán chuỗi rỗng\n      stock_quantity: safeQty     // Gán tồn kho đã kiểm tra an toàn\n    }\n  };\n});\n"
      },
